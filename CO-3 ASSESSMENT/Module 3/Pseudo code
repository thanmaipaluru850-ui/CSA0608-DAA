ALGORITHM BinarySearchFirst(A, target)

INPUT: Sorted list of orders and target timestamp
OUTPUT: First matching order position

1. low = 0
2. high = length(A) - 1
3. result = -1

4. WHILE low <= high DO

5.     mid = (low + high) // 2

6.     IF A[mid].timestamp == target THEN
           result = mid
           high = mid - 1

7.     ELSE IF A[mid].timestamp < target THEN
           low = mid + 1

8.     ELSE
           high = mid - 1

9.     END IF

10. END WHILE

11. RETURN result

END ALGORITHM
