ALGORITHM Partition(A, low, high)

1. pivot = A[high]
2. i = low - 1

3. FOR j = low TO high - 1 DO

4.     IF A[j] <= pivot THEN
           i = i + 1
           Swap A[i] and A[j]
       END IF

5. END FOR

6. Swap A[i + 1] and A[high]

7. RETURN i + 1

END ALGORITHM
