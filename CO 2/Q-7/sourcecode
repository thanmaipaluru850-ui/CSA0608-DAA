n = int(input("Enter number of packages: "))

weights = []
values = []

for i in range(n):
    w, v = map(int, input(
        "Enter weight and value: "
    ).split())

    weights.append(w)
    values.append(v)

capacity = int(input("Enter maximum capacity: "))

# Create DP table
dp = [[0 for j in range(capacity + 1)]
      for i in range(n + 1)]

# Fill DP table
for i in range(1, n + 1):
    for w in range(capacity + 1):

        if weights[i - 1] <= w:
            dp[i][w] = max(
                values[i - 1] +
                dp[i - 1][w - weights[i - 1]],

                dp[i - 1][w]
            )
        else:
            dp[i][w] = dp[i - 1][w]

# Find selected packages
selected = []
w = capacity

for i in range(n, 0, -1):
    if dp[i][w] != dp[i - 1][w]:
        selected.append(i)
        w -= weights[i - 1]

selected.reverse()

print("\nSelected Packages:", selected)
print("Maximum Value:", dp[n][capacity])
print("DP States:", n * (capacity + 1))
