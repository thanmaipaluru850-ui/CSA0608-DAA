import math

n = int(input("Enter number of points: "))

points = []

for i in range(n):
    x, y = map(float, input("Enter x and y coordinates: ").split())
    points.append((x, y))

min_distance = float('inf')
closest_pair = None
pairs = 0

for i in range(n - 1):
    for j in range(i + 1, n):
        pairs += 1

        x1, y1 = points[i]
        x2, y2 = points[j]

        distance = math.sqrt(
            (x2 - x1)**2 + (y2 - y1)**2
        )

        if distance < min_distance:
            min_distance = distance
            closest_pair = (points[i], points[j])

print("Closest Pair:", closest_pair)
print("Minimum Distance:", round(min_distance, 2))
print("Pairs Examined:", pairs)
print("Distance Calculations:", pairs)
