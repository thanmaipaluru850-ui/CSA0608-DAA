import math

def distance(p1, p2):
    return math.sqrt((p1[0] - p2[0]) ** 2 +
                     (p1[1] - p2[1]) ** 2)


def closest_pair(points):
    if len(points) <= 3:
        return min(
            (distance(points[i], points[j])
             for i in range(len(points))
             for j in range(i + 1, len(points))),
            default=float('inf')
        )

    mid = len(points) // 2

    left = points[:mid]
    right = points[mid:]

    d1 = closest_pair(left)
    d2 = closest_pair(right)

    d = min(d1, d2)

    mid_x = points[mid][0]

    strip = [p for p in points
             if abs(p[0] - mid_x) < d]

    strip.sort(key=lambda p: p[1])

    for i in range(len(strip)):
        for j in range(i + 1, min(i + 8, len(strip))):
            d = min(d, distance(strip[i], strip[j]))

    return d


n = int(input())

points = []

for i in range(n):
    x, y = map(int, input().split())
    points.append((x, y))

points.sort()

print("Closest Distance =", round(closest_pair(points), 2))
