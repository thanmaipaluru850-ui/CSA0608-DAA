ALGORITHM MAX_MIN(A, low, high)

1. If low = high:
      Return A[low], A[low]

2. If high = low + 1:
      If A[low] > A[high]:
          Return A[low], A[high]
      Else:
          Return A[high], A[low]

3. mid = (low + high) / 2

4. (max1, min1) = MAX_MIN(A, low, mid)

5. (max2, min2) = MAX_MIN(A, mid+1, high)

6. Maximum = max(max1, max2)

7. Minimum = min(min1, min2)

8. Return Maximum, Minimum

END
