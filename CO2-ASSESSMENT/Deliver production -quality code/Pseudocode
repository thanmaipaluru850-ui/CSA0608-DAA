4. Pseudocode for Signature Matching
BEGIN

n = LENGTH(log)
m = LENGTH(pattern)
INITIALIZE hits AS EMPTY LIST

IF m = 0 THEN
    RETURN hits
END IF

FOR i = 0 TO n - m

    j = 0

    WHILE j < m AND log[i + j] = pattern[j]
        j = j + 1
    END WHILE

    IF j = m THEN
        ADD i TO hits
    END IF

END FOR

RETURN hits
END

5. Pseudocode for Closest Login Pair
BEGIN

IF LENGTH(events) < 2 THEN
    RETURN NONE
END IF

min_dist_squared = INFINITY
pair = NONE

FOR i = 0 TO LENGTH(events) - 2

    FOR j = i + 1 TO LENGTH(events) - 1

        dx = events[i].x - events[j].x
        dy = events[i].y - events[j].y

        distance_squared = dx * dx + dy * dy

        IF distance_squared < min_dist_squared THEN

            min_dist_squared = distance_squared
            pair = (i, j)

        END IF

    END FOR

END FOR

distance = SQRT(min_dist_squared)

RETURN pair, distance
END

