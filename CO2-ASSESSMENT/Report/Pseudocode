1. Insertion Sort – Alert Sorting
BEGIN
    FOR i = 1 TO n-1
        key = alerts[i]
        j = i-1

        WHILE j >= 0 AND alerts[j].severity < key.severity
            alerts[j+1] = alerts[j]
            j = j-1
        END WHILE

        alerts[j+1] = key
    END FOR
    RETURN alerts
END

2. Blocklist Search – Optimised Using Set
BEGIN
    blocked_set = CONVERT blocklist INTO SET

    IF ip EXISTS IN blocked_set
        RETURN TRUE
    ELSE
        RETURN FALSE
    END IF
END

3. Brute-Force String Matching
BEGIN
    FOR i = 0 TO n-m
        j = 0

        WHILE j < m AND log[i+j] = pattern[j]
            j = j+1
        END WHILE

        IF j = m
            ADD i TO hits
        END IF
    END FOR

    RETURN hits
END

4. Closest Pair – Optimised
BEGIN
    min_dist_squared = INFINITY
    pair = NONE

    FOR i = 0 TO n-2
        FOR j = i+1 TO n-1

            dx = events[i].x - events[j].x
            dy = events[i].y - events[j].y
            d_squared = dx*dx + dy*dy

            IF d_squared < min_dist_squared
                min_dist_squared = d_squared
                pair = (i, j)
            END IF
        END FOR
    END FOR

    RETURN pair, SQRT(min_dist_squared)
END
